generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema", "relationJoins"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["front_dev", "public"]
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model user {
  id               Int      @id @default(autoincrement())
  username         String   @unique(map: "username") @db.VarChar(50)
  password         String   @db.VarChar(255)
  role             String?  @default(dbgenerated("USER")) @db.VarChar(20)
  created_time     DateTime @default(now()) @db.Timestamp(6)
  updated_time     DateTime @default(now()) @db.Timestamp(6)
  employee_id      String?  @db.VarChar(255)
  supervisor       String?  @db.VarChar(255)
  team             String?  @db.VarChar(255)
  responsible_area String?  @db.VarChar(255)

  @@schema("front_dev")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model business_manager_region_info {
  id                   Int       @id @default(autoincrement())
  business_person_id   String?   @db.VarChar(36)
  business_person_name String?   @db.VarChar(50)
  region_code          String?   @db.VarChar(20)
  region_cn            String?   @db.VarChar(100)
  region_level         String?   @db.Char(1)
  team                 String?   @db.VarChar(20)
  start_date           DateTime? @db.Date
  end_date             DateTime? @default(dbgenerated("'9999-12-31'::date")) @db.Date
  data_status          String?   @default("1") @db.Char(1)
  created_time         DateTime  @default(now()) @db.Timestamp(6)
  updated_time         DateTime  @default(now()) @db.Timestamp(6)

  @@schema("public")
}

